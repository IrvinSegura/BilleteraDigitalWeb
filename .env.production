# Empty when the app is served from the API's own site (same origin or behind the same reverse proxy). Otherwise
# set it to the API's base URL, on the same site, and list this app's origin in the API's CORS_ALLOWED_ORIGINS.
VITE_API_URL=

# Sentry DSN for browser error reports (Project Settings > Client Keys); empty turns reporting off. Its ingest
# origin is added to the CSP's connect-src at build time. Set VITE_APP_VERSION (e.g. the commit SHA) in CI so each
# report names its build.
VITE_SENTRY_DSN=

# Cloudflare Turnstile site key, the pair of the API's TURNSTILE_SECRET_KEY: production APIs refuse sign-ups and
# password reset requests without it. Adds challenges.cloudflare.com to the CSP's script-src and frame-src.
VITE_TURNSTILE_SITE_KEY=

# Where people who can't sign in reach support, shown on the sign-in page; the support chat needs a session, so
# without it a disabled account or a lost phone has nowhere to go. Empty hides it.
VITE_SUPPORT_EMAIL=
