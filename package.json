    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^1.67.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
