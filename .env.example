# Empty: calls go to /api on the dev server, which proxies them to the local API (./mvnw spring-boot:run in the
# backend repo). Point the proxy elsewhere with API_PROXY_TARGET in .env.development.local.
VITE_API_URL=

# Off in development; set it in .env.development.local to try error reporting locally
VITE_SENTRY_DSN=

# Off in development, like the local API's CAPTCHA_ENABLED. To try it, set Cloudflare's test site key
# 1x00000000000000000000AA here and run the API with CAPTCHA_ENABLED=true and the test secret (see its README)
VITE_TURNSTILE_SITE_KEY=

# Shown on the sign-in page, for people who can't sign in and so can't use the support chat
VITE_SUPPORT_EMAIL=soporte@wallet.local
